# Copy to .env and replace every placeholder. Never commit .env.
LEDGER_POSTGRES_PASSWORD=<random-url-safe-database-password>
LEDGER_PASSWORD_HASH='<argon2id-phc-hash>'
LEDGER_ADMIN_PASSWORD_HASH='<argon2id-phc-hash>'
LEDGER_TRUSTED_PROXY_CIDR=<upstream-reverse-proxy-cidr>

# Public-safe placeholders and generic defaults; replace URLs before deployment.
LEDGER_PUBLIC_URL=https://ledger.example.com
LEDGER_INFER_URL=http://inference.example.com/v1
LEDGER_EMBED_MODEL=qwen3-embedding
LEDGER_EMBED_DIM=4096
LEDGER_RERANK_MODEL=qwen3-reranker
# Override these together if this subnet overlaps an existing Docker network.
LEDGER_INTERNAL_SUBNET=10.251.250.0/24
LEDGER_NGINX_INTERNAL_IP=10.251.250.254
# LEDGER_INFER_API_KEY=<inference-api-key-if-required>
